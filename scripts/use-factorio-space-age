#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/use-factorio-space-age VERSION
  scripts/use-factorio-space-age VERSION --file /path/to/factorio-space-age_linux_VERSION.tar.xz
  scripts/use-factorio-space-age --disable

Default installer directory:
  ~/Sync/Factorio Install

Future version workflow:
  1. Put factorio-space-age_linux_VERSION.tar.xz in ~/Sync/Factorio Install
  2. Run: cd ~/CirnOS && scripts/use-factorio-space-age VERSION
  3. Run: rebuild
EOF
}

repo_root=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel 2>/dev/null || realpath "$(dirname "$0")/..")
config_file="$repo_root/home/factorio-space-age-local.nix"
install_dir="${FACTORIO_INSTALL_DIR:-$HOME/Sync/Factorio Install}"
version=
tarball=
disable=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --disable)
      disable=true
      shift
      ;;
    --file)
      if [[ $# -lt 2 ]]; then
        echo "use-factorio-space-age: --file needs a path" >&2
        exit 2
      fi
      tarball=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "use-factorio-space-age: unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      if [[ -n "$version" ]]; then
        echo "use-factorio-space-age: only one VERSION is supported" >&2
        usage
        exit 2
      fi
      version=$1
      shift
      ;;
  esac
done

nix_escape() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s' "$value"
}

write_config() {
  local enable=$1
  local cfg_version=$2
  local cfg_install_path=$3
  local cfg_src_store_path=$4
  local cfg_sha256=$5
  local cfg_sri_hash=$6
  local cfg_store_name=$7
  local tmp

  tmp=$(mktemp)
  cat >"$tmp" <<EOF
# Generated by scripts/use-factorio-space-age. Do not edit by hand.
#
# To switch versions, put factorio-space-age_linux_VERSION.tar.xz in:
#   /home/krieger/Sync/Factorio Install
# Then run:
#   cd ~/CirnOS && scripts/use-factorio-space-age VERSION && rebuild
{
  enable = ${enable};
  version = "$(nix_escape "$cfg_version")";
  installPath = "$(nix_escape "$cfg_install_path")";
  srcStorePath = "$(nix_escape "$cfg_src_store_path")";
  sha256 = "$(nix_escape "$cfg_sha256")";
  sriHash = "$(nix_escape "$cfg_sri_hash")";
  storeName = "$(nix_escape "$cfg_store_name")";
}
EOF
  mv "$tmp" "$config_file"
}

if [[ "$disable" == true ]]; then
  if [[ -n "$version" || -n "$tarball" ]]; then
    echo "use-factorio-space-age: --disable cannot be combined with VERSION or --file" >&2
    exit 2
  fi

  write_config false "" "" "" "" "" ""
  echo "Factorio Space Age disabled. Run: rebuild"
  exit 0
fi

if [[ -z "$version" ]]; then
  usage
  exit 2
fi

if [[ ! "$version" =~ ^[0-9]+([.][0-9]+)+([._-][0-9A-Za-z]+)*$ ]]; then
  echo "use-factorio-space-age: suspicious version string: $version" >&2
  exit 2
fi

if [[ -z "$tarball" ]]; then
  tarball="$install_dir/factorio-space-age_linux_${version}.tar.xz"
fi

if [[ ! -f "$tarball" ]]; then
  echo "use-factorio-space-age: installer not found: $tarball" >&2
  echo "Available installers:" >&2
  find "$install_dir" -maxdepth 1 -type f -name 'factorio-space-age_linux_*.tar.xz' -printf '  %f\n' 2>/dev/null | sort >&2 || true
  exit 1
fi

real_tarball=$(realpath "$tarball")
store_name="factorio_expansion_x64-${version}.tar.xz"
sha256_hex=$(sha256sum "$real_tarball" | awk '{print $1}')
sri_hash=$(nix hash convert --hash-algo sha256 --to sri "$sha256_hex")
src_store_path=$(nix store add --mode flat --hash-algo sha256 --name "$store_name" "$real_tarball")

write_config true "$version" "$real_tarball" "$src_store_path" "$sha256_hex" "$sri_hash" "$store_name"

echo "Selected Factorio Space Age ${version}"
echo "Installer: $real_tarball"
echo "Store path: $src_store_path"
echo "Hash: $sri_hash"
echo
echo "Run: rebuild"
